{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(./gradlew:*)",
      "PowerShell(.\\gradlew.bat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(curl:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(test)",
      "Skill(code_convention)",
      "Bash(Get-ChildItem:*)",
      "Bash(Select-Object:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(javap:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm:*)",
      "Bash(Remove-Item:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(Stop-Process:*)",
      "PowerShell(Get-NetTCPConnection:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}